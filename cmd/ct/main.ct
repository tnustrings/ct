    // defer f.Close()?
    fc.Handle(err)
``

write and print which file was written.

``
    f.WriteString(text)
    fmt.Println(path)
``


shouldtc says whether ct or tc should be run: if one of the generated
files is newer than ct file, run tc, else run ct.

``/shouldtc:
func shouldtc(ctfile string, genfiles []string) bool, err {
    ctinfo, err := fs.FileInfo(ctfile)
    if err != nil { return (false, err) }

    for _, genfile := range genfiles {
        geninfo, err := fs.FileInfo(genfile)
        if err != nil { return (false, err) }
        if geninfo.ModTime.After(ctinfo.ModTime) {
            // one generated file was modified after ct file was modified, run tc
            return true
        }
    }
    // all generated files were modified before ct file was modified, run ct
    return false
}
``

filesfromgen returns the paths of associated files (ct file and
generated files) from the header of a generated file. a header line would be:
#ct myprog.ct gen1.py gen2.py genx.sh
often only one file is generated from a ct file.

``/filesfromgen:
func filesfromgen(genfile string) string, []string, error {
    ``_``
}
``

get the file extension, dir, and load the programming language info.

``_:
    ext := filepath.Ext(genfile)
    dir := fc.Dir(genfile)    
    prog := getpl(conf, ext)
``

make an regexp to fish for the header line.

``
    re := regexp.MustCompile("^" + prog.Cmtmark + "ct (.*)$")
``

open the file and make a scanner.

``
    file, err := os.Open(genfile)
    if err != nil { return err }
    defer file.Close()
    scanner = bufio.NewScanner(file)
``

read the lines, see whether a line matches.

``
    for scanner.Scan() {
        line := scanner.Text()
        if re.MatchString(line) {
            ``.``
        }
    }
``

on match, extract the file names.

``
            match, _ := re.FindStringSubmatch(line)
            if len(match) < 1 { log.Fatal(genfile + ": no filenames in line " + line) }
            filenames = strings.split(match[1], " ") // TODO quote-sensitive split?
``

return complete paths.

``
            paths := []string{}
            for _, path := range filenames {
                if dir != "" { path = dir + "/" + path } // TODO okay so?
                paths = append(paths, path)
            }
            return paths[0], paths[1:], nil
``

if no ct line found, error.

``/filesfromgen/_
    log.Fatal("no ct-line in " + genfile)
``

filesfromct returns the paths of the files generated from a ct file.

``/filesfromct:
func filesfromct(ctfile) []string, err {
    ``_``
}
``

run codetext.

``
    err := Ct(text, ctfile)
    if err != nil { return nil, err }
``

get the directory.

``
    dir := fc.Dir(path)
``

collect the generated filenames, return the complete paths.

``
    out := []string{}
    for path, _ := range roots { // TODO run this on a ct instance? or let Ct() return the roots?
        if dir != "" { path = dir + "/" + path } // TODO okay so?

        out = append(out, path)
